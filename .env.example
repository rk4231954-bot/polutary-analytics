# Copy to .env and fill in real values. Never commit .env.

# --- Flask API (apps/api) ---
# The full list of API settings, with explanations, is in apps/api/.env.example.
# The API reads apps/api/.env first, then this file.
APP_ENV=development
# REQUIRED, at least 32 random characters:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
API_HOST=127.0.0.1
API_PORT=5000
# SQLite application database (users, farms, audit log); relative paths live in apps/api/instance/
DATABASE_URL=sqlite:///polutary.sqlite3
# CSV upload limit (MB) and dataset folder (default <repo>/data; raw/ and processed/ inside)
MAX_UPLOAD_MB=50
DATA_DIR=
# Exact frontend origins (comma-separated, never "*"), e.g. add your Vercel URL
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Same-site dev (Vite proxy): Lax/false. Cross-site (Vercel → HTTPS API): None/true.
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_SECURE=false

# --- Apache Hive (HiveServer2 via PyHive) ---
HIVE_HOST=localhost
HIVE_PORT=10000
# HiveServer2 user. Queries run as this user (doAs), so it needs HDFS access to the tables.
HIVE_USERNAME=
# Database holding poultry_records_cleaned (the table analytics are computed from).
HIVE_DATABASE=poultry_analytics
# NONE | NOSASL | LDAP | CUSTOM. The project's HiveServer2 uses CUSTOM (password file, see
# infrastructure/hadoop-hive/README.md); HIVE_PASSWORD is used only with LDAP/CUSTOM.
HIVE_AUTH=CUSTOM
HIVE_PASSWORD=
# NameNode HTTP address (JMX + WebHDFS). Read-only, for the Big Data status page.
WEBHDFS_URL=http://127.0.0.1:9870
# --- Processed uploads in HDFS (WebHDFS writes, read back and SHA-256 checked) ---
HDFS_ENABLED=true
# HDFS user for writes (simple auth). Empty = HIVE_USERNAME, then the OS user.
HDFS_USER=
HDFS_PROCESSED_DIR=/polutary/processed
# Native single-node install bound to 127.0.0.1: the NameNode redirects to the DataNode's
# hostname, which may not resolve to loopback. Empty = use the redirect unchanged.
HDFS_DATANODE_HOST=127.0.0.1
# Hive external table (partitioned by farm_id, upload_id) over HDFS_PROCESSED_DIR.
HIVE_UPLOADS_TABLE=poultry_uploads

# --- Machine Learning (apps/ml) ---
ML_MODELS_DIR=apps/ml/models
ML_RANDOM_STATE=42

# --- Frontend (apps/web, read by Vite; only VITE_* values reach the browser — never put secrets here) ---
# Relative /api uses the Vite dev proxy (target below). Use a full URL for other setups.
VITE_API_BASE_URL=/api
# Where the Vite dev proxy forwards /api requests.
VITE_DEV_API_TARGET=http://127.0.0.1:5000
# Preview mode: read-only views show clearly labelled SAMPLE data.
# Defaults to true for `bun run dev` and false for production builds. Set to false once the API is connected.
VITE_DEMO_MODE=true
VITE_API_TIMEOUT_MS=20000
VITE_MAX_UPLOAD_MB=50
