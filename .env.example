# Copy to .env and fill in real values. Never commit .env.

# --- Flask API (apps/api) ---
FLASK_ENV=development
FLASK_DEBUG=1
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
API_HOST=127.0.0.1
API_PORT=5000
# SQLite application database (users, farms, audit log, upload metadata)
DATABASE_URL=sqlite:///instance/polutary.sqlite3
MAX_UPLOAD_MB=50
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Hadoop HDFS (WebHDFS) ---
HDFS_NAMENODE_URL=http://localhost:9870
HDFS_USER=hadoop
HDFS_BASE_DIR=/polutary
HDFS_RAW_DIR=/polutary/raw
HDFS_PROCESSED_DIR=/polutary/processed

# --- Apache Hive (HiveServer2 via PyHive) ---
HIVE_HOST=localhost
HIVE_PORT=10000
HIVE_USERNAME=hive
HIVE_DATABASE=poultry
# NONE | NOSASL | LDAP | KERBEROS | CUSTOM
HIVE_AUTH=NONE
HIVE_PASSWORD=

# --- Machine Learning (apps/ml) ---
ML_MODELS_DIR=apps/ml/models
ML_RANDOM_STATE=42

# --- Frontend (apps/web, read by Vite; must be prefixed VITE_) ---
VITE_API_BASE_URL=/api
