# Flask API settings. Copy to apps/api/.env and fill in real values. Never commit .env.
# The API reads apps/api/.env first, then the repository-root .env (real environment variables win).

# development | production | testing
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=5000

# REQUIRED. At least 32 random characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Optional separate key for signing JWTs (defaults to SECRET_KEY).
JWT_SECRET_KEY=

# SQLAlchemy URL. A relative SQLite path is created inside apps/api/instance/.
# PostgreSQL later: postgresql+psycopg://user:password@host:5432/polutary (and add the driver).
DATABASE_URL=sqlite:///polutary.sqlite3

# Exact frontend origins allowed to call the API with cookies (comma-separated, no "*").
# Local Vite dev server + your Vercel site, e.g.:
#   CORS_ALLOWED_ORIGINS=http://localhost:5173,https://polutary-analytics.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Session cookies ---
# Local development through the Vite proxy (same site): Lax + Secure=false.
# Frontend on another domain (Vercel) with the API on HTTPS: JWT_COOKIE_SAMESITE=None + JWT_COOKIE_SECURE=true.
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_SECURE=false
JWT_ACCESS_MINUTES=30
JWT_REFRESH_WINDOW_MINUTES=10
SESSION_MAX_HOURS=12
SESSION_REMEMBER_DAYS=7

# --- Throttling ---
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_SECONDS=900
REGISTER_MAX_PER_IP=10
REGISTER_WINDOW_SECONDS=3600

# Number of reverse proxies in front of the API (0 when running directly).
# Needed so rate limiting and audit logs see the real client IP.
TRUST_PROXY_COUNT=0
# Send Strict-Transport-Security (only when served over HTTPS).
HSTS_ENABLED=false
# Maximum JSON request body size in KB.
MAX_REQUEST_KB=64

# --- CSV dataset uploads ---
# Maximum CSV upload size in MB (1-500). Keep VITE_MAX_UPLOAD_MB in the root .env the same.
MAX_UPLOAD_MB=50
# Where uploaded and processed datasets are stored (raw/ and processed/ are created inside).
# Default: <repository>/data. Must not be inside apps/web.
DATA_DIR=

# --- Apache Hive (HiveServer2 via PyHive): analytics endpoints ---
HIVE_HOST=localhost
HIVE_PORT=10000
# HiveServer2 user. Queries run as this user (doAs), so it needs HDFS access to the tables.
HIVE_USERNAME=
HIVE_DATABASE=poultry_analytics
# NONE | NOSASL | LDAP | CUSTOM. The project's HiveServer2 uses CUSTOM (password file, see
# infrastructure/hadoop-hive/README.md); HIVE_PASSWORD is used only with LDAP/CUSTOM.
HIVE_AUTH=CUSTOM
HIVE_PASSWORD=
# NameNode HTTP address (JMX + WebHDFS). Read-only, for the Big Data status page.
WEBHDFS_URL=http://127.0.0.1:9870
# --- Processed uploads in HDFS (WebHDFS writes, read back and SHA-256 checked) ---
HDFS_ENABLED=true
# HDFS user for writes (simple auth). Empty = HIVE_USERNAME, then the OS user.
HDFS_USER=
HDFS_PROCESSED_DIR=/polutary/processed
# Native single-node install bound to 127.0.0.1: the NameNode redirects to the DataNode's
# hostname, which may not resolve to loopback. Empty = use the redirect unchanged.
HDFS_DATANODE_HOST=127.0.0.1
# Hive external table (partitioned by farm_id, upload_id) over HDFS_PROCESSED_DIR.
HIVE_UPLOADS_TABLE=poultry_uploads
# Hive external table over HDFS_PROCESSED_DIR/flock_performance (Kaggle flock reference data).
HIVE_FLOCK_TABLE=flock_performance
